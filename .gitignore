# MACSS — the requisitions authoring workspace, machine-written and
# reproducible from the CLI. The .macss/ workspace is not listed here: it
# carries its own .gitignore, which a rule at this level would render dead.
docs/requisitions/

# Dependencies
node_modules/
.dart_tool/
build/
.packages

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment
.env
.env.local
.env.*.local

# Build outputs
dist/
out/
*.exe
*.dll
*.so
*.dylib

# Logs
*.log
npm-debug.log*

# Coverage
coverage/
.nyc_output/

# Lockfiles. The Dart convention splits by package kind: an application pins its
# resolution so every machine builds the same bytes, a library must not, because
# its consumers do the resolving. skillwire_cli is an application and commits
# its lock; the skillwire package is a library and does not.
code/skillwire/pubspec.lock

# Local dependency overrides. The site pins the design system to a commit;
# an override is for iterating on both at once and must never be committed,
# or CI would build against a directory it does not have.
pubspec_overrides.yaml
